# ============================================================
# 同花顺（10jqka）接口配置模板
# 复制为 .env 后按需修改；所有配置均有内置默认值，可全部省略。
# ============================================================

# 个股财报（diy_report 模板）导出接口，{code}/{userid} 为占位符
# THS_DIY_URL=https://basic.10jqka.com.cn/api/stock/export.php?export=diy&type=simple&code={code}&userid={userid}

# 资产负债表导出接口，{code} 为占位符
# THS_DEBT_URL=https://basic.10jqka.com.cn/api/stock/export.php?export=debt&type=report&code={code}

# 股票名称搜索接口（用于根据 code 反查股票名），{code} 为占位符
# THS_SEARCH_URL=https://news.10jqka.com.cn/app/headline/mobi-stockdict/v1/search/?isrealcode=1&associate=1&json=1&markettype=2&query={code}

# diy 接口 userid 参数（默认 723895634）
# THS_USERID=723895634

# 对同花顺域任意两次请求的最小间隔秒数（默认 2.0，防拉黑请勿调小）
# THS_MIN_INTERVAL=2.0

# 单只股票解析结果缓存秒数（默认 600，期间重复请求直接用缓存）
# THS_RESULT_TTL=600

# 股票名称缓存秒数（默认 86400 即 24 小时）
# THS_NAME_TTL=86400

# 可选：同花顺 Cookie（遇反爬拦截时手动填写，格式 k1=v1; k2=v2）
# THS_COOKIE=
